# /etc/spark-access/env  (root:spark-access, mode 640). Read by the systemd unit.
# No quotes needed; values are taken literally.

# --- Admin sign-in for this app ---
ADMIN_USERNAME=admin
# Generate with: sudo /opt/spark-access/venv/bin/python -m app.security  (run in /opt/spark-access)
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Storage (default /var/lib/spark-access/spark-access.db; set a path you own when running without install) ---
# SPARK_ACCESS_DB=/home/you/team-access/spark-access/spark-access.db

# --- Linux (onboard-user.sh / offboard-user.sh through sudo) ---
LINUX_ENABLED=true
SCRIPTS_DIR=/opt/spark-access/scripts

# --- LiteLLM ---
LITELLM_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=
LITELLM_MAX_PARALLEL=4

# --- Portainer (Community Edition) ---
# Portainer -> My account -> Access tokens -> Add access token (as an admin user)
PORTAINER_URL=https://127.0.0.1:9443
PORTAINER_API_KEY=
PORTAINER_TEAM=Developers
PORTAINER_VERIFY_TLS=false
PORTAINER_SANDBOX_ENV=Sandbox        # environment whose <user>-* stacks are deleted on offboarding

# --- Turnstone (console admin API) ---
# An API token for a Turnstone admin user with scopes read,write,approve (see README)
TURNSTONE_URL=https://127.0.0.1:443
TURNSTONE_ADMIN_TOKEN=
# Role given to every new Turnstone user: its name as shown in Turnstone (or its role_id)
TURNSTONE_ROLE=spl-dev
TURNSTONE_VERIFY_TLS=false

# --- JupyterHub (leave JUPYTERHUB_USERS_FILE empty to skip) ---
# The folder ~/jupyterhub/access is mounted into the hub; spark-access writes users.json there.
JUPYTERHUB_USERS_FILE=
# JUPYTERHUB_USERS_FILE=/home/spl/jupyterhub/access/users.json
JUPYTERHUB_URL=http://127.0.0.1:8000
# Same value as SPARK_ACCESS_API_TOKEN in the jupyterhub stack (openssl rand -hex 32)
JUPYTERHUB_API_TOKEN=
# Signs in to JupyterHub as admin with this app's admin password
JUPYTERHUB_ADMIN=spl
JUPYTERHUB_DEFAULT_CPU=4
JUPYTERHUB_DEFAULT_MEM_GB=8
JUPYTERHUB_MAX_CPU=20
JUPYTERHUB_MAX_MEM_GB=64

# --- Shown to new people on the result page ---
OFFICE_BASE_URL=http://192.168.1.20:4000/v1
TAILSCALE_BASE_URL=http://spark:4000/v1
TURNSTONE_PUBLIC_URL=https://192.168.1.20
PORTAINER_PUBLIC_URL=https://192.168.1.20:9443
JUPYTERHUB_PUBLIC_URL=http://192.168.1.20:8000

# Leave any system's key empty to skip that system (its column shows "skipped").
